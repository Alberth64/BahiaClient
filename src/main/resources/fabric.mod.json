{
  "schemaVersion": 1,
  "id": "bahiaclient",
  "version": "${version}",
  "name": "BahiaClient",
  "description": "A client-side Minecraft mod with organized HUD, visual, and macro features.",
  "icon": "assets/bahiaclient/icon.png",
  "authors": [
    "BahiaClient"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.bahiaclient.BahiaClient"
    ],
    "modmenu": [
      "dev.bahiaclient.BahiaClientModMenu"
    ]
  },
  "mixins": [
    {
      "config": "bahiaclient.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.161.0+26.2"
  },
  "suggests": {
    "modmenu": "*"
  }
}
