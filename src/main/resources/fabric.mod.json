{
  "schemaVersion": 1,
  "id": "zeyafabricmoon",
  "version": "${version}",
  "name": "ZeyaMoon — Primordial Eclipse Moon",
  "description": "A client-side Minecraft mod with organized HUD, visual, and macro features.",
  "icon": "assets/zeyafabricmoon/icon.png",
  "authors": [
    "Zeya"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.zeya.fabricmoon.ZeyaFabricMoonClient"
    ],
    "modmenu": [
      "dev.zeya.fabricmoon.ZeyaFabricMoonModMenu"
    ]
  },
  "mixins": [
    {
      "config": "zeyafabricmoon.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.161.0+26.2"
  },
  "suggests": {
    "modmenu": "*"
  }
}
